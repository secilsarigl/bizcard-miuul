# n8n (local Docker) ortam değişkenleri için şablon.
# Gerçek değerlerle bu dosyayı `env/.env` olarak kopyala; `.env` git'e girmez.

# n8n'in Chat Trigger (RAG + Memory) adımında kullanacağı AI sağlayıcısı anahtarı.
# OpenAI kullanılıyorsa:
OPENAI_API_KEY=

# Anthropic kullanılıyorsa (OPENAI_API_KEY yerine):
# ANTHROPIC_API_KEY=

# RAG için vektör store bağlantısı (seçilen çözüme göre doldurulacak).
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=

# n8n public API key (n8n arayüzünden alınır).
N8N_API_KEY=

# Google OAuth (Google Cloud Console'daki OAuth Client ID/Secret).
GOOGLE_CONSOLE_CLIENT_ID=
GOOGLE_CONSOLE_CLIENT_SECRET=
